<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter xmlns="https://github.com/spotbugs/filter/3.0.0">
    <!-- Lombok @Data/@Getter 生成的 getter 直接返回集合字段，触发 EI_EXPOSE_REP。
         这是 Lombok 的已知限制，修复需改业务代码（不在 CI 门禁范围内）。 -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <!-- Lombok @Builder 生成的构造器可在校验失败时抛异常，触发 CT_CONSTRUCTOR_THROW。
         Lombok 生成的代码无法在 pom 层面修复。 -->
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>
    <!-- Lombok @Builder/@NonNull 生成的无参构造器未初始化 @NonNull 字段，
         触发 NP_NONNULL_FIELD_NOT_INITIALIZED_IN_CONSTRUCTOR。 -->
    <Match>
        <Bug pattern="NP_NONNULL_FIELD_NOT_INITIALIZED_IN_CONSTRUCTOR"/>
    </Match>
    <!-- Lombok 生成的 equals()/hashCode() 包含冗余空检查，
         触发 RCN_REDUNDANT_NULLCHECK_OF_NONNULL_VALUE。 -->
    <Match>
        <Bug pattern="RCN_REDUNDANT_NULLCHECK_OF_NONNULL_VALUE"/>
    </Match>
</FindBugsFilter>
