      {
        "id": "main",
        "label": "主链",
        "focus": [
          "unsubmitted",
          "submitted",
          "working",
          "completed"
        ],
        "note": "UNSPECIFIED→SUBMITTED→WORKING→COMPLETED 是单轮任务的成功主链。"
      },
      {
        "id": "interrupt",
        "label": "中断等待",
        "focus": [
          "working",
          "input_required",
          "auth_required"
        ],
        "note": "WORKING 可转 INPUT_REQUIRED/AUTH_REQUIRED 挂起；客户端补输入或完成授权后回 WORKING。"
      },
      {
        "id": "terminal",
        "label": "终态",
        "focus": [
          "submitted",
          "rejected",
          "input_required",
          "failed",
          "completed"
        ],
        "note": "COMPLETED 成功；FAILED/CANCELED/REJECTED 失败终态。isTerminal 后不再允许迁移。"
      }
    ]
  },
