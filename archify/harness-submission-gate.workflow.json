      "variant": "emphasis"
    },
    {
      "id": "submit-review",
      "from": "submit",
      "to": "review",
      "label": "进入评审",
      "variant": "emphasis"
    },
    {
      "id": "review-accept",
      "from": "review",
      "to": "accept",
      "variant": "emphasis"
    },
    {
      "id": "accept-complete",
      "from": "accept",
      "to": "complete",
      "label": "验收结果",
      "variant": "emphasis"
    },
    {
      "id": "complete-done",
      "from": "complete",
      "to": "done",
      "label": "全部 PASS",
      "variant": "emphasis"
    },
    {
      "id": "submit-rec",
      "from": "submit",
      "to": "submission",
      "variant": "default"
    },
    {
      "id": "review-rec",
      "from": "review",
      "to": "review_rec",
      "variant": "default"
    },
    {
      "id": "accept-rec",
      "from": "accept",
      "to": "accept_rec",
      "variant": "default"
    },
    {
      "id": "complete-gate",
      "from": "complete",
      "to": "gate_rec",
      "label": "GateResult×N",
      "variant": "default"
    },
    {
      "id": "eval-accept",
      "from": "evaluator",
      "to": "accept",
      "variant": "default"
    },
    {
      "id": "review-rework",
      "from": "review",
      "to": "agent",
      "label": "CHANGES_REQUESTED→ACTIVE",
      "variant": "dashed",
      "role": "return"
    },
    {
      "id": "complete-repair",
      "from": "complete",
      "to": "repair",
      "label": "FAIL→CompletionFailure",
      "variant": "dashed"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "完成门禁",
      "items": [
        "completeTask 先 validateCompletion：契约可要求最新评审 APPROVED、evidenceIds 非空",
        "contract.evaluateCompletion 在写锁外评估；每个 GateResult 落 GateRecord，任一 FAIL → CompletionFailure"
      ]
    },
    {
      "dot": "violet",
      "title": "验收与修复",
      "items": [
        "AcceptanceCoordinator.evaluate 产出 Evaluation：AcceptanceRecord+EvidenceRecord，bindAcceptanceToSubmission 绑定提交",
        "ArtifactContractGate 做确定性契约校验；repair(parentExecutionId) 起带子执行 lineage 的修复执行"
      ]
    }
  ]
}