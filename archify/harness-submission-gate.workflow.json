{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "提交→评审→验收→门禁→DONE：完成治理管线",
    "locale": "zh-CN",
    "animation": "trace",
    "visual_preset": "signal-flow",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "pipeline",
        "label": "完成管线",
        "focus": [
          "agent",
          "submit",
          "review",
          "accept",
          "complete",
          "done"
        ],
        "note": "submitTask→IN_REVIEW→评审→验收→completeTask 门禁→DONE，每步落台账记录。"
      },
      {
        "id": "rework",
        "label": "返工与修复",
        "focus": [
          "review",
          "agent",
          "complete",
          "gate_rec",
          "repair"
        ],
        "note": "CHANGES_REQUESTED 把任务打回 ACTIVE 返工；门禁 FAIL 抛 CompletionFailure，可 repair(parentExecutionId) 起 lineage 子执行。"
      }
    ]
  },
  "lanes": [
    {
      "id": "caller",
      "label": "宿主 / 评审 / 验收调用面"
    },
    {
      "id": "gateway",
      "label": "CommandGateway（唯一写面·状态机校验）"
    },
    {
      "id": "ledger",
      "label": "HarnessStore 台账",
      "variant": "exception"
    }
  ],
  "phases": [
    {
      "id": "submit_p",
      "label": "提交与评审",
      "fromCol": 0,
      "toCol": 2
    },
    {
      "id": "accept_p",
      "label": "验收",
      "fromCol": 3,
      "toCol": 3,
      "variant": "emphasis"
    },
    {
      "id": "gate_p",
      "label": "门禁与结果",
      "fromCol": 4,
      "toCol": 5,
      "variant": "dashed"
    }
  ],
  "groups": [
    {
      "id": "records",
      "label": "每步落不可变台账记录",
      "lane": "ledger",
      "fromCol": 1,
      "toCol": 4
    }
  ],
  "mainPath": [
    "agent",
    "submit",
    "review",
    "accept",
    "complete",
    "done"
  ],
  "nodes": [
    {
