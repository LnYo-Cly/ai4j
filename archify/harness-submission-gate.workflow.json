    },
    {
      "id": "done",
      "lane": "caller",
      "col": 5,
      "type": "backend",
      "label": "Task → DONE",
      "sublabel": "须最新评审 APPROVED",
      "width": 132
    },
    {
      "id": "submit",
      "lane": "gateway",
      "col": 1,
      "type": "backend",
      "label": "submitTask",
      "sublabel": "task→IN_REVIEW",
      "width": 132
    },
    {
      "id": "review",
      "lane": "gateway",
      "col": 2,
      "type": "security",
      "label": "reviewSubmission",
      "sublabel": "评审者 verdict+findings",
      "tag": "verdict",
      "width": 140
    },
    {
      "id": "accept",
      "lane": "gateway",
      "col": 3,
      "type": "backend",
      "label": "AcceptanceCoordinator.evaluate",
      "sublabel": "评估+绑定验收",
      "width": 210
    },
    {
      "id": "complete",
      "lane": "gateway",
      "col": 4,
      "type": "security",
      "label": "completeTask",
      "sublabel": "validateCompletion+门禁",
