      "width": 140
    },
    {
      "id": "submission",
      "lane": "ledger",
      "col": 1,
      "type": "database",
      "label": "SubmissionRecord",
      "sublabel": "附 evidenceIds",
      "width": 132
    },
    {
      "id": "review_rec",
      "lane": "ledger",
      "col": 2,
      "type": "database",
      "label": "ReviewRecord",
      "sublabel": "verdict+findings",
      "width": 140
    },
    {
      "id": "accept_rec",
      "lane": "ledger",
      "col": 3,
      "type": "database",
      "label": "AcceptanceRecord+Evidence",
      "sublabel": "PASS/FAIL/ERROR/NOT_RUN",
      "width": 168
    },
    {
      "id": "gate_rec",
      "lane": "ledger",
      "col": 4,
      "type": "database",
      "label": "GateRecord",
      "sublabel": "每门禁一条 PASS/FAIL",
      "width": 132
