  "cards": [
    {
      "dot": "cyan",
      "title": "外循环判定",
      "items": [
        "每轮：throwIfInterrupted → maxTotalTurns 检查 → runSingleTurn → 累加 tokens/cost/toolCalls → decide → continue 则带 continuationPrompt 进下一轮",
        "输出文本模式驱动：QUESTION_PATTERN 停等用户输入、COMPLETION_PATTERN 判完成、CONTINUE_PATTERN 自动续跑（受 maxAutoFollowUps 限）"
      ]
    },
    {
      "dot": "violet",
      "title": "stopReason 谱系",
      "items": [
        "BLOCKED_BY_APPROVAL / BLOCKED_BY_TOOL_ERROR：审批拒绝或工具错误且 stopOnApprovalBlock 时停；turnError 经 ErrorTrackingAgentListener 捕获",
        "MAX_TOTAL_TURNS_REACHED 硬上限、CONTINUATION_REQUIRED、INTERRUPTED、ERROR——decision 记入 session.recordLoopDecision"
      ]
    },
    {
      "dot": "amber",
      "title": "Workspace 提示词",
      "items": [
        "buildWorkspacePrompt：root 路径 + 工具选择指引（read/write/edit/apply_patch/bash/bash_process/update_agents_md）+ apply_patch 语法 + shell 用法",
        "Skills/Prompts 索引 + AGENTS.md 正文（<agents_md> 包裹）并入；allowOutsideWorkspace=false 时明确不依赖工作区外文件"
      ]
    }
  ]
