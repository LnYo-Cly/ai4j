  "cards": [
    {
      "dot": "cyan",
      "title": "两路注入语义",
      "items": [
        "automatic：技能指令直接并入 systemPrompt，每轮对模型可见",
        "selected：挂进 OverlayMemory 按需展开——先露名字/描述，模型需要时再读正文"
      ]
    },
    {
      "dot": "violet",
      "title": "文件访问边界",
      "items": [
        "read_skill_file 工具按 allowedReadRoots 白名单限定可读根，越界路径被拒",
        "技能正文不预占上下文：只有模型主动 read 才进记忆"
      ]
    },
    {
      "dot": "amber",
      "title": "编码侧富化",
      "items": [
        "CodingSkillDiscovery 在 coding 运行时把技能发现结果并入 WorkspaceContext 参与组词",
        "AgentSkillRuntimeSupport.apply 是唯一分流点：automatic/selected 两条路径互不混"
      ]
    }
  ]
