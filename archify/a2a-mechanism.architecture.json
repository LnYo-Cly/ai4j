  "cards": [
    {
      "dot": "cyan", "title": "协议面与任务生命周期",
      "items": [
        "角色对称：A2AClient/A2ATool 调任意对端 Agent；A2AServer 同时被任意 A2A 客户端调用——同一 JSON-RPC 协议面",
        "方法：SendMessage · SendStreamingMessage · GetTask · ListTasks · CancelTask · SubscribeToTask · PushConfig CRUD",
        "发现 /.well-known/agent-card.json（回退 agent.json）；别名 /tasks/send · /message:send · /message/send 同步 run 不入任务表",
        "TaskState：SUBMITTED→WORKING→{INPUT|AUTH_REQUIRED}→COMPLETED/FAILED/CANCELED/REJECTED；内存表 ≤1024，CancelTask→future.cancel(true)"
      ]
    },
    {
      "dot": "violet", "title": "事件扇出、推送与限额",
      "items": [
        "SSE：首帧完整 Task 快照（锁内注册防丢帧）→ statusUpdate / artifactUpdate；每任务 ≤64 订阅",
        "Push ≤32 配置/任务：同事件体 POST，X-A2A-Notification-Token + AuthenticationInfo；回调默认仅公网 HTTPS（SSRF 防护）",
        "线程池 HTTP 64 · worker 32 · callback 16；请求体 / SSE 事件 ≤1MB；A2ATool=远端 Agent→ToolExecutor；A2ASkillMapper→AgentCard.skills"
      ]
    }
  ]
