  "cards": [
    {
      "dot": "emerald",
      "title": "隔离边界",
      "items": [
        "每扩展 JAR 一个 URLClassLoader，实现类互不污染",
        "SPI 契约类型由父加载器共享，instanceof 语义一致",
        "隔离解决依赖冲突——不是安全沙箱，不可信代码需进程边界"
      ]
    },
    {
      "dot": "rose",
      "title": "事务语义",
      "items": [
        "apply() 的注册先落暂存态，全部成功才换入运行快照",
        "任一扩展 apply 失败：回滚已注册项 + onStop + 关闭其加载器",
        "清理钩子抛错不掩盖原始 apply 失败原因"
      ]
    },
    {
      "dot": "orange",
      "title": "命名空间与生命周期",
      "items": [
        "扩展工具统一 plugin__<id>__<tool>，杜绝跨插件撞名",
        "expose 仍接受裸名——解析器按后缀唯一匹配，歧义报错",
        "disable 逆序执行 onStop 并逆序关闭 classloader/资源"
      ]
    }
  ]
