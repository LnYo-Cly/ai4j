      },
      {
        "id": "merge",
        "label": "召回融合",
        "focus": ["fanout", "fusion", "rerank", "hits"],
        "note": "每个变体独立走 Dense+BM25 召回 → FusionStrategy 合流去重 → Reranker 重排出 RagHit。"
      }
