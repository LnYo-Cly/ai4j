    {"id": "variants", "lane": "plan", "col": 2, "type": "backend", "label": "变体集", "sublabel": "6 类·maxVariants", "width": 140},
    {"id": "fanout", "lane": "recall", "col": 3, "type": "backend", "label": "多变体召回", "sublabel": "Dense+BM25 并行", "width": 150},
    {"id": "fusion", "lane": "recall", "col": 4, "type": "security", "label": "FusionStrategy", "sublabel": "RRF/RSF/DBSF", "width": 150},
    {"id": "rerank", "lane": "rank", "col": 4, "type": "security", "label": "Reranker", "sublabel": "Model/Chat/Noop", "width": 140},
