  ],
  "edges": [
    {"id": "e1", "from": "query_in", "to": "planner", "label": "query", "variant": "emphasis"},
    {"id": "e2", "from": "planner", "to": "variants", "label": "按策略改写", "variant": "emphasis"},
    {"id": "e3", "from": "variants", "to": "fanout", "label": "逐变体召回", "variant": "emphasis"},
    {"id": "e4", "from": "fanout", "to": "fusion", "label": "多路 hits", "variant": "emphasis"},
    {"id": "e5", "from": "fusion", "to": "rerank", "label": "融合去重", "variant": "default"},
    {"id": "e6", "from": "rerank", "to": "hits", "label": "重排出 topK", "variant": "emphasis"}
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "变体策略（RagQueryVariantType）",
      "items": [
        "ORIGINAL 原句直通；REWRITE 改写；MULTI_QUERY 多角度扩展；HYDE 假设答案；STEP_BACK 抽象上位；CUSTOM 自定义",
        "strategies 逐个调模型生成，达 maxVariants（默认 6）即截断；includeOriginal 默认保留原查询"
      ]
    },
    {
      "dot": "violet",
      "title": "三选一融合策略",
      "items": [
        "RRF（倒数名次融合）：按各变体排名 1/(k+rank) 求和，对分数尺度不敏感",
        "RSF 分数归一融合；DBSF 分布融合——AbstractScoreFusionStrategy 提供骨架，RagScoreDetail 记分数来源"
      ]
    },
    {
      "dot": "amber",
      "title": "排序与出口",
      "items": [
        "Reranker 三实现：ModelReranker 专用重排模型 · ChatReranker 用 Chat 模型打分 · NoopReranker 直通",
        "RagHit 携 chunk+score+sourceDetail 进 ContextAssembler 组装，引用链到 RagCitation"
      ]
    }
  ]
}
