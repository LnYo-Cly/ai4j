    {
      "dot": "rose",
      "title": "入口校验链",
      "items": [
        "非 POST → 405；鉴权失败 → 401（A2AServer.java:538-548）",
        "JSON 畸形 → -32700；jsonrpc≠\"2.0\" → -32600（:563-593）",
        "A2A-Version 不符 → -32009；未知方法 → -32601（:597-619）"
      ]
    },
    {
      "dot": "cyan",
      "title": "任务执行",
      "items": [
        "registerTask 锁内去重，任务容量 ≤1024（:1190-1200）",
        "worker 池 ≤32，run / runStreamResult 驱动 AgentSession（:722-765）",
        "MODEL_RESPONSE 事件逐条写入 artifact，终态不可逆（:737-758）"
      ]
    },
    {
      "dot": "emerald",
      "title": "扇出与推送",
      "items": [
        "快照与订阅者注册在同一记录锁内完成，无丢帧窗口（:803-811）",
        "每个流式响应同时发 SSE 订阅者与全部 push 配置（:1156-1170）",
        "push 仅投公网 HTTPS 回调，5s 超时、不跟随重定向（:1216-1244）"
      ]
    }
  ]
