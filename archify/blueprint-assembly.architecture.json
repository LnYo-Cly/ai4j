  "cards": [
    {
      "dot": "cyan",
      "title": "P1-A 只做文档",
      "items": [
        "Loader 白名单 11 个顶层字段（version/id/name/model/instructions/plugins/tools/session/sandbox/workflow/extensions），未知字段进 unknownFields",
        "Validator 逐项校验：version 必须 ai4j.agent/v1、id 字符集、model/plugins/tools/session/sandbox/workflow——不创建也不运行任何 Agent"
      ]
    },
    {
      "dot": "violet",
      "title": "P1-B 宿主供给",
      "items": [
        "AgentFactoryContext 提供 modelClient 与各项 Supplier——Factory 不读 provider token、不解析本地 profile、不安装插件",
        "sandbox.enabled 声明必须配合 ctx.allowSandboxDeclaration，否则抛 AgentFactoryException（不创建真实沙箱会话）"
      ]
    },
    {
      "dot": "amber",
      "title": "校验闸门",
      "items": [
        "Factory 内部复用同一 Validator：report.isValid=false → AgentFactoryException(blueprint.validation.failed) 携带报告",
        "每条 issue 带 JSONPath（如 $.version、$.tools[0].name）+ 错误码 + severity，便于定位非法声明"
      ]
    }
  ]
