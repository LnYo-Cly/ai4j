  "cards": [
    {
      "dot": "cyan",
      "title": "ContextBudget 四档",
      "items": [
        "maxItems：保留 pinnedPrefixItems 前缀 + 尾部若干，中间丢弃；maxApproxChars：按估算字符数再裁一刀",
        "maxRecentToolResults（Tier-1 微压缩）：老 tool 输出变占位符，保留结构去掉体积；trimOldReasoning（Tier-2）：裁历史推理"
      ]
    },
    {
      "dot": "violet",
      "title": "投影 ≠ 删除",
      "items": [
        "projector.project 只作用于本次 prompt 的 items 视图——memory 本体不动，下一轮原始历史仍在",
        "ContextReport 记录 source/projected/dropped 计数与触发的限制，经 MEMORY_COMPRESS 事件可观测"
      ]
    },
    {
      "dot": "amber",
      "title": "组装次序（源码序）",
      "items": [
        "systemPrompt = mergeText(context.systemPrompt, runtimeInstructions)；instructions 独立字段进 prompt",
        "visibleTools = registry 经 AgentToolVisibility.filter——是请求投影而非授权；最后 ModelRequestHook 还能整体改写"
      ]
    }
  ]
