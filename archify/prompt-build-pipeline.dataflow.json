  "cards": [
    {
      "dot": "cyan",
      "title": "组装顺序",
      "items": [
        "每步模型调用前重建：合并 systemPrompt 与 instructions，挂 visibleTools",
        "再把 ContextProjector 按 ContextBudget 选出的 memory items 投影进请求"
      ]
    },
    {
      "dot": "violet",
      "title": "投影语义",
      "items": [
        "投影不动 AgentMemory 本体；裁剪结果由 ContextReport 记录并触发 MEMORY_COMPRESS 事件",
        "TypeAwareContextProjector 按 item 类型加权，DefaultContextProjector 按序截断"
      ]
    },
    {
      "dot": "amber",
      "title": "末次改写",
      "items": [
        "ModelRequestHook 在发送前可对请求做最后一次统一改写（如注入追踪头）",
        "Chat 与 Responses 客户端共用该管线，差异在 ModelClient 内部适配"
      ]
    }
  ]
