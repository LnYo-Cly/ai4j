  "cards": [
    {
      "dot": "cyan",
      "title": "有界切片 + 租约",
      "items": [
        "每次 run 只跑一段 bounded slice：claim 租约+fencingToken → 心跳续约 → adapter.open → session.run → 状态映射 → persistExecutionOutcome",
        "持久化失败/租约丢失 → ExecutionStatus.UNKNOWN 待对账；Agent 的 ReAct/压缩/权限/沙箱/MCP 全部照旧由 Agent 负责"
      ]
    },
    {
      "dot": "violet",
      "title": "WAITING 六种原因",
      "items": [
        "adapter 返回 waitId（EXTERNAL_EVENT/ASYNC_OPERATION/RETRY/TIME）或抛 AgentHostInputException(USER_INPUT)/AgentApprovalRequiredException(APPROVAL) → WaitRecord + WAITING",
        "deliver(waitId,input)：answer+wakeup 原子落库 → READY → 同步跑下一段切片；applyDelivery=false 时值作为下轮 input"
      ]
    },
    {
      "dot": "amber",
      "title": "恢复、幂等与修复",
      "items": [
        "checkpointState+adapterState+sessionSnapshot 随 outcome 落库；重启后 resume(executionId)/resumeTask/autoResume 续跑；idempotencyKey 防重复 execution",
        "repair(parentExecutionId,…)：校验父执行终态 → 子 execution 自动挂 lineage；evaluateAcceptance 走 AcceptanceCoordinator（见验收图）"
      ]
    }
  ]
