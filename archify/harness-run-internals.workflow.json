{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "一次 run 的内部管线：claim→open→切片→落库→deliver 回路",
    "locale": "zh-CN",
    "animation": "trace",
    "visual_preset": "signal-flow",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "slice",
        "label": "有界切片",
        "focus": [
          "host",
          "claim",
          "open",
          "session",
          "snapshot",
          "map",
          "persist",
          "result"
        ],
        "note": "跟随一次 run(request)：claim 租约 → adapter.open → session.run → snapshot → 结果落库。"
      },
      {
        "id": "wait-loop",
        "label": "等待回路",
        "focus": [
          "map",
          "ensure_wait",
          "host",
          "delivery",
          "claim"
        ],
        "note": "结果映射到 WAITING 后由 deliver(waitId,input) 唤醒，execution 回 READY 进入下一切片。"
      }
    ]
  },
  "lanes": [
    {
      "id": "caller",
      "label": "宿主调用面 Host API"
    },
    {
      "id": "runtime",
      "label": "AgentHarness 外循环 · ExecutionAdapter"
    },
    {
      "id": "ledger",
      "label": "CommandGateway + Store",
      "variant": "exception"
    }
  ],
  "phases": [
    {
      "id": "intake",
      "label": "接收与认领",
      "fromCol": 0,
      "toCol": 1
