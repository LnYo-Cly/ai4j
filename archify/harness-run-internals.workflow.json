      "id": "slice",
      "label": "有界切片",
      "fromCol": 2,
      "toCol": 4,
      "variant": "emphasis"
    },
    {
      "id": "outcome",
      "label": "落库与出口",
      "fromCol": 5,
      "toCol": 5,
      "variant": "dashed"
    }
  ],
  "groups": [
    {
      "id": "slice_group",
      "label": "每切片一个真实 AdapterSession",
      "lane": "runtime",
      "fromCol": 2,
      "toCol": 4,
      "variant": "emphasis"
    }
  ],
  "mainPath": [
    "host",
    "claim",
    "open",
    "session",
    "snapshot",
    "map",
    "persist"
  ],
  "nodes": [
    {
      "id": "host",
      "lane": "caller",
      "col": 0,
