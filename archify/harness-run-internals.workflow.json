      "label": "run(request)/resume(execId)",
      "variant": "emphasis"
    },
    {
      "id": "claim-open",
      "from": "claim",
      "to": "open",
      "variant": "emphasis"
    },
    {
      "id": "open-session",
      "from": "open",
      "to": "session",
      "variant": "default"
    },
    {
      "id": "session-snapshot",
      "from": "session",
      "to": "snapshot",
      "variant": "default"
    },
    {
      "id": "snapshot-map",
      "from": "snapshot",
      "to": "map",
      "variant": "default"
    },
    {
      "id": "map-wait",
      "from": "map",
      "to": "ensure_wait",
      "label": "waitId/HostInput/Approval",
      "variant": "security"
    },
    {
      "id": "map-persist",
      "from": "map",
      "to": "persist",
      "label": "完成/失败",
      "variant": "emphasis"
    },
    {
      "id": "wait-host",
      "from": "ensure_wait",
      "to": "host",
      "label": "WAITING 返回",
      "variant": "security"
    },
    {
      "id": "persist-result",
      "from": "persist",
      "to": "result",
      "variant": "emphasis"
    },
    {
      "id": "host-deliver",
      "from": "host",
      "to": "delivery",
      "label": "deliver 唤醒等待",
      "variant": "dashed"
    },
    {
      "id": "delivery-ready",
      "from": "delivery",
      "to": "claim",
      "label": "answer+wakeup→READY",
      "variant": "dashed",
      "role": "return"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "有界切片",
      "items": [
        "每次 run 只跑一段受 HarnessRunBudget 约束的切片：open 建真实 session、跑 ReAct/工具、snapshot 导出状态",
        "claim 生成租约+fencingToken；持久化校验 fencing 拒绝陈旧 worker 的迟到写入"
      ]
    },
    {
      "dot": "violet",
      "title": "deliver 回路",
      "items": [
        "切片返回 waitId 或抛 HostInput/ApprovalRequired → ensureWait 落 WaitRecord+Wakeup，执行转 WAITING",
        "deliver(waitId,input) 原子写 answer+wakeup 转 READY；下一切片从 prevState+answer 恢复续跑"
      ]
    }
  ]
}