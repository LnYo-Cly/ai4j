      "label": "Host / Worker",
      "sublabel": "run/resume/deliver 入口",
      "width": 132
    },
    {
      "id": "result",
      "lane": "caller",
      "col": 5,
      "type": "backend",
      "label": "HarnessRunResult",
      "sublabel": "CONTINUE/WAIT/终态",
      "width": 132
    },
    {
      "id": "claim",
      "lane": "runtime",
      "col": 1,
      "type": "security",
      "label": "claimExecution",
      "sublabel": "租约+fencingToken",
      "tag": "lease",
      "width": 132
    },
    {
      "id": "open",
      "lane": "runtime",
      "col": 2,
      "type": "backend",
      "label": "adapter.open",
      "sublabel": "ctx+budget+prevState",
      "width": 132
    },
    {
      "id": "session",
      "lane": "runtime",
      "col": 3,
      "type": "backend",
      "label": "session.run",
      "sublabel": "每切片一 session",
