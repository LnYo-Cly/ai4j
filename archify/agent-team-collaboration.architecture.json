  "cards": [
    {
      "dot": "cyan",
      "title": "两条独立通道",
      "items": [
        "任务协作走 TaskBoard：claim/release/reassign/heartbeat/超时回收；消息走 MessageBus：direct/broadcast/read 信箱投递——成员间不直接互调（AgentTeam.java, AgentTeamTaskBoard.java）",
        "team_send_message / team_broadcast / team_read_messages / team_*_task 是成员可调用的团队工具（agent/team/tool/）"
      ]
    },
    {
      "dot": "violet",
      "title": "派发语义",
      "items": [
        "默认 maxRounds=64 轮调度；maxConcurrency 固定线程池并行派发；成员 prompt 拼装角色+任务ID+依赖+可选目标/上下文/近期消息",
        "成功→completed+task.result 回 lead；失败→failed+task.error，continueOnMemberError 决定继续或中止"
      ]
    },
    {
      "dot": "amber",
      "title": "与 SubAgent 的本质区别",
      "items": [
        "Team 成员是对等协作者：Planner 分工、TaskBoard 认领、MessageBus 信箱通信——不是 lead→sub 的工具调用 RPC",
        "状态可持久化：AgentTeamStateStore / FileAgentTeamMessageBus 支持恢复；TEAM_TASK_*/TEAM_MESSAGE 事件全程可观测"
      ]
    }
  ]
