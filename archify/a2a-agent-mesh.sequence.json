  "cards": [
    {
      "dot": "slate",
      "title": "任务边界",
      "items": [
        "每跳任务独立：上游 taskId / contextId 不透传到下游；A2ATool 只转发 message 文本（A2ATool.java:37-40）",
        "跨跳关联由编排层负责，协议本身无分布式事务"
      ]
    },
    {
      "dot": "emerald",
      "title": "同进程双角色",
      "items": [
        "A2AServer（入站）与 A2AClient（出站）互不依赖，可同进程共存",
        "入站跑 workerExecutor（≤32）、出站走 client 自身连接；上游只见本端终态"
      ]
    },
    {
      "dot": "amber",
      "title": "中断传播",
      "items": [
        "CancelTask 只取消本跳（future.cancel(true) :784-794）；下游取消需再发一次",
        "COMPLETED / FAILED / CANCELED 终态不可逆（TaskState.java:116-126）"
      ]
    }
